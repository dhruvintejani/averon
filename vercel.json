{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/track-shipment",
      "destination": "/shipment-status",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/seo/about.html" },
    { "source": "/services", "destination": "/seo/services.html" },
    { "source": "/services/ocean-freight", "destination": "/seo/services-ocean-freight.html" },
    { "source": "/services/air-freight", "destination": "/seo/services-air-freight.html" },
    { "source": "/services/customs-clearance", "destination": "/seo/services-customs-clearance.html" },
    { "source": "/services/road-inland-transport", "destination": "/seo/services-road-inland-transport.html" },
    { "source": "/services/warehousing-distribution", "destination": "/seo/services-warehousing-distribution.html" },
    { "source": "/services/supply-chain-management", "destination": "/seo/services-supply-chain-management.html" },
    { "source": "/services/project-cargo-breakbulk", "destination": "/seo/project-cargo-breakbulk.html" },
    { "source": "/lcl-consolidation", "destination": "/seo/lcl-consolidation.html" },
    { "source": "/global-reach", "destination": "/seo/global-reach.html" },
    { "source": "/contact", "destination": "/seo/contact.html" },
    { "source": "/shipment-status", "destination": "/seo/shipment-status.html" },
    { "source": "/privacy-policy", "destination": "/seo/privacy-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/seo/terms-and-conditions.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
